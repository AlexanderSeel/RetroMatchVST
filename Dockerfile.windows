# escape=`
FROM mcr.microsoft.com/dotnet/framework/runtime:4.8-windowsservercore-ltsc2022 AS builder

ARG JUCE_TAG=9.0.1
ARG CONFIG=Release

SHELL ["powershell", "-NoLogo", "-ExecutionPolicy", "Bypass", "-Command"]

# Keep this instruction stable so a successful Visual Studio Build Tools layer
# can be reused from Docker's build cache on later retries.
RUN New-Item -ItemType Directory -Force C:\TEMP | Out-Null; Invoke-WebRequest -UseBasicParsing https://aka.ms/vs/17/release/vs_buildtools.exe -OutFile C:\TEMP\vs_buildtools.exe; $p = Start-Process C:\TEMP\vs_buildtools.exe -ArgumentList '--quiet','--wait','--norestart','--nocache','--installPath','C:\BuildTools','--add','Microsoft.VisualStudio.Workload.VCTools','--add','Microsoft.VisualStudio.Component.VC.CMake.Project','--includeRecommended' -Wait -PassThru; if ($p.ExitCode -notin @(0, 3010)) { exit $p.ExitCode }; Remove-Item C:\TEMP\vs_buildtools.exe -Force

# The MSVC x64/x86 compiler is a recommended component of the workload rather
# than a required one. Some container installs therefore end up with the SDK
# and CMake integration but no cl.exe. Add the compiler component explicitly
# when needed, then verify the toolset before attempting project configuration.
RUN $cl = Get-ChildItem 'C:\BuildTools\VC\Tools\MSVC\*\bin\Hostx64\x64\cl.exe' -ErrorAction SilentlyContinue | Sort-Object FullName -Descending | Select-Object -First 1; if (-not $cl) { Write-Host 'MSVC compiler was not installed by the workload; adding Microsoft.VisualStudio.Component.VC.Tools.x86.x64 explicitly...'; Invoke-WebRequest -UseBasicParsing https://aka.ms/vs/17/release/vs_buildtools.exe -OutFile C:\TEMP\vs_buildtools.exe; $p = Start-Process C:\TEMP\vs_buildtools.exe -ArgumentList '--quiet','--wait','--norestart','--nocache','--installPath','C:\BuildTools','--add','Microsoft.VisualStudio.Component.VC.Tools.x86.x64' -Wait -PassThru; if ($p.ExitCode -notin @(0, 3010)) { exit $p.ExitCode }; Remove-Item C:\TEMP\vs_buildtools.exe -Force; $cl = Get-ChildItem 'C:\BuildTools\VC\Tools\MSVC\*\bin\Hostx64\x64\cl.exe' -ErrorAction SilentlyContinue | Sort-Object FullName -Descending | Select-Object -First 1 }; if (-not $cl) { throw 'MSVC x64 compiler (cl.exe) is still missing after installing Microsoft.VisualStudio.Component.VC.Tools.x86.x64.' }; $vcTargets='C:\BuildTools\MSBuild\Microsoft\VC\v170\Microsoft.Cpp.Default.props'; if (-not (Test-Path $vcTargets)) { throw 'Visual C++ MSBuild targets are missing.' }; $version=(Get-Item $cl.FullName).VersionInfo.FileVersion; Write-Host 'MSVC compiler ready:' $cl.FullName 'version' $version

# Server Core LTSC 2022 is Windows build 20348. Newer SDK 26100 rc.exe has been
# observed to crash in this container. Install Microsoft's serviced 20348 SDK
# using the standalone SDK installer so headers, libraries and tools are added
# together. The fwlink currently resolves to the serviced 10.0.20348.3330 SDK.
ARG WINSDK_VERSION=10.0.20348.0
RUN $sdkRoot='C:\Program Files (x86)\Windows Kits\10'; $sdkHeader=Join-Path $sdkRoot "Include\${env:WINSDK_VERSION}\um\Windows.h"; $sdkLib=Join-Path $sdkRoot "Lib\${env:WINSDK_VERSION}\um\x64\kernel32.lib"; $sdkRc=Join-Path $sdkRoot "bin\${env:WINSDK_VERSION}\x64\rc.exe"; $complete=(Test-Path $sdkHeader) -and (Test-Path $sdkLib) -and (Test-Path $sdkRc); if (-not $complete) { Write-Host 'Installing complete serviced Windows SDK 20348 desktop C++ payload...'; Invoke-WebRequest -UseBasicParsing https://go.microsoft.com/fwlink/?linkid=2331862 -OutFile C:\TEMP\winsdksetup.exe; $p = Start-Process C:\TEMP\winsdksetup.exe -ArgumentList '/features','OptionId.DesktopCPPx64','OptionId.SigningTools','/quiet','/norestart' -Wait -PassThru; if ($p.ExitCode -notin @(0, 3010)) { exit $p.ExitCode }; Remove-Item C:\TEMP\winsdksetup.exe -Force }; if (-not (Test-Path $sdkHeader)) { throw 'Windows SDK 20348 header payload is incomplete: Windows.h missing.' }; if (-not (Test-Path $sdkLib)) { throw 'Windows SDK 20348 library payload is incomplete: kernel32.lib missing.' }; if (-not (Test-Path $sdkRc)) { throw 'Windows SDK 20348 tool payload is incomplete: rc.exe missing.' }; Write-Host 'Windows SDK 20348 ready:' $sdkHeader $sdkLib $sdkRc

ARG MINGIT_VERSION=2.55.0.5
ARG MINGIT_RELEASE=v2.55.0.windows.5
ARG MINGIT_SHA256=56D7B226B7693196CFC71FEF26568F536C4A021AB6C37FF2DB4287BED908E96E

# Install the official portable Git distribution. CMake's FetchContent needs
# git.exe, and using Git to obtain JUCE keeps the source checkout explicit and
# verifies it before the project configuration runs. Do not set Docker ENV PATH
# here: a Windows Docker ENV such as ENV PATH="...;${PATH}" can leave a literal
# ${PATH} in the environment and make powershell.exe unreachable in later layers.
RUN $archive='C:\TEMP\mingit.zip'; Invoke-WebRequest -UseBasicParsing "https://github.com/git-for-windows/git/releases/download/${env:MINGIT_RELEASE}/MinGit-${env:MINGIT_VERSION}-64-bit.zip" -OutFile $archive; $actual=(Get-FileHash -Algorithm SHA256 $archive).Hash; if ($actual -ne $env:MINGIT_SHA256) { throw "MinGit checksum mismatch. Expected $env:MINGIT_SHA256, got $actual." }; Expand-Archive $archive -DestinationPath C:\Git; Remove-Item $archive -Force; & C:\Git\cmd\git.exe --version; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

RUN & C:\Git\cmd\git.exe clone --depth 1 --branch $env:JUCE_TAG https://github.com/juce-framework/JUCE.git C:\JUCE; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; if (-not (Test-Path C:\JUCE\CMakeLists.txt)) { throw 'JUCE clone completed without C:\JUCE\CMakeLists.txt.' }

WORKDIR C:\src
COPY . .

# Initialize the actual MSVC environment with VsDevCmd.bat and use NMake,
# which avoids Visual Studio instance discovery inside Windows containers.
RUN & C:\Windows\System32\cmd.exe /D /C C:\src\scripts\build-container-windows.cmd $env:CONFIG; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

RUN New-Item -ItemType Directory -Force C:\out | Out-Null; Copy-Item -Recurse -Force "C:\build\RetroMatchSynth_artefacts\${env:CONFIG}\VST3" C:\out\VST3; Copy-Item -Recurse -Force "C:\build\RetroMatchSynth_artefacts\${env:CONFIG}\Standalone" C:\out\Standalone

CMD ["powershell.exe", "-NoLogo"]
